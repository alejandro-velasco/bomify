{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "echo \"version=${nextRelease.version}\" >> $GITHUB_OUTPUT",
        "prepareCmd": "make dist VERSION=${nextRelease.version} && make plugin-packages VERSION=${nextRelease.version} && make build-container CONTAINER_TAG=${nextRelease.version}",
        "publishCmd": "make push-container CONTAINER_TAG=${nextRelease.version} && make push-plugin-packages VERSION=${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "assets": [
          { "path": "dist/bomify-*-linux-amd64", "label": "Linux (amd64)" },
          { "path": "dist/bomify-*-linux-arm64", "label": "Linux (arm64)" },
          { "path": "dist/bomify-*-darwin-amd64", "label": "macOS (amd64)" },
          { "path": "dist/bomify-*-darwin-arm64", "label": "macOS (arm64)" },
          { "path": "dist/bomify-*-windows-amd64.exe", "label": "Windows (amd64)" },
          { "path": "dist/checksums.txt", "label": "Checksums" }
        ]
      }
    ]
  ]
}
