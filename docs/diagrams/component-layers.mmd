%%{init: {"flowchart": {"wrappingWidth": 320}}}%%
flowchart TB
    classDef local fill:#EEF2FF,stroke:#6366F1,stroke-width:1.5px,color:#1e1b4b
    classDef decision fill:#F8FAFC,stroke:#64748B,stroke-width:1.5px,color:#0f172a
    classDef tar fill:#ECFDF5,stroke:#10B981,stroke-width:1.5px,color:#064e3b
    classDef whole fill:#EFF6FF,stroke:#3B82F6,stroke-width:1.5px,color:#1e3a8a
    classDef part fill:#FFFBEB,stroke:#F59E0B,stroke-width:1.5px,color:#78350f

    subgraph Rule["Each file of a component, in path order"]
        direction LR
        File[("file")]
        Large{"regular file of<br/>64 MiB or more?"}
        Fits{"4 GiB or less?"}
        Grouped("grouped into the current tar layer;<br/>the next tar starts when a file<br/>would take this one past 4 GiB")
        Whole("one file part layer:<br/>the whole file")
        Parts("file part layers of 4 GiB each,<br/>the last holding the rest")

        File --> Large
        Large -- "no: smaller, or a symlink" --> Grouped
        Large -- yes --> Fits
        Fits -- yes --> Whole
        Fits -- no --> Parts
    end

    subgraph Example["Example: a component's files, and its layers in manifest order (tars first, then large files by path)"]
        direction TB
        subgraph Row1[" "]
            direction LR
            R1File[("config.json · 2 KB<br/>latest.json · symlink to config.json<br/>tokenizer.json · 9 MB")] --> R1Layer("layer 1 · tar<br/>config.json, latest.json, tokenizer.json")
        end
        subgraph Row2[" "]
            direction LR
            R2File[("adapter.bin · 500 MB")] --> R2Layer("layer 2 · file part<br/>adapter.bin, the whole file")
        end
        subgraph Row3[" "]
            direction LR
            R3File[("weights.bin · 10 GiB")] --> R3Layer("layers 3–5 · file parts<br/>weights.bin 1/3: 0 – 4 GiB<br/>weights.bin 2/3: 4 – 8 GiB<br/>weights.bin 3/3: 8 – 10 GiB")
        end
        Row1 ~~~ Row2 ~~~ Row3
    end


    Rule ~~~ Example

    class File,R1File,R2File,R3File local
    class Large,Fits decision
    class Grouped,R1Layer tar
    class Whole,R2Layer whole
    class Parts,R3Layer part
    style Rule fill:#FAFAFA,stroke:#CBD5E1,stroke-width:1px,color:#334155
    style Example fill:#FAFAFA,stroke:#CBD5E1,stroke-width:1px,color:#334155
    style Row1 fill:none,stroke:none
    style Row2 fill:none,stroke:none
    style Row3 fill:none,stroke:none
