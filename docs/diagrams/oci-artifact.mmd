flowchart LR
    classDef local fill:#EEF2FF,stroke:#6366F1,stroke-width:1.5px,color:#1e1b4b
    classDef oci fill:#ECFDF5,stroke:#10B981,stroke-width:1.5px,color:#064e3b
    classDef ociFinal fill:#D1FAE5,stroke:#059669,stroke-width:2px,color:#022c22
    classDef sig fill:#FFFBEB,stroke:#F59E0B,stroke-width:1.5px,color:#78350f
    classDef vuln fill:#FEF2F2,stroke:#EF4444,stroke-width:1.5px,color:#7f1d1d

    subgraph Local["bomify data directory"]
        SBOM[("SBOM")]
        Image[("image, as an OCI image layout<br/>pkg:oci")]
        Chart[("chart archive<br/>pkg:helm")]
        Model[("model files<br/>pkg:huggingface")]
        Files[("other files<br/>pkg:generic")]
        Report[("vulnerability reports")]
    end

    subgraph Package["package, in one repository"]
        Index{{"index — what the tag points at"}}
        SBOMManifest("SBOM manifest<br/>config: the SBOM<br/>layers: files map, extra files")
        ImageManifest("the image's own manifest")
        ChartManifest("the chart's manifest, as helm push builds it")
        ModelManifest("ModelPack manifest")
        FilesManifest("bomify component manifest")
    end

    subgraph Referrers["referrers"]
        Reports("vulnerability reports<br/>(only if any component was scanned)")
        Signed("signatures, VEX, provenance")
    end

    SBOM -- "verbatim" --> SBOMManifest
    Image -- "oci plugin's pack: as it is,<br/>its digest kept" --> ImageManifest
    Chart -- "helm plugin's pack" --> ChartManifest
    Model -- "a raw layer per file" --> ModelManifest
    Files -- "a layer per file" --> FilesManifest
    Report -- "verbatim, annotated with purl" --> Reports
    Index --> SBOMManifest
    Index -- "annotated with purl" --> ImageManifest
    Index -- "annotated with purl" --> ChartManifest
    Index -- "annotated with purl" --> ModelManifest
    Index -- "annotated with purl" --> FilesManifest
    Reports -- "subject" --> Index
    Signed -- "subject" --> Index

    class SBOM,Image,Chart,Model,Files,Report local
    class SBOMManifest,ImageManifest,ChartManifest,ModelManifest,FilesManifest oci
    class Index ociFinal
    class Reports vuln
    class Signed sig
    style Local fill:#F8FAFF,stroke:#C7D2FE,stroke-width:1px,color:#334155
    style Package fill:#F0FDF9,stroke:#A7F3D0,stroke-width:1px,color:#334155
    style Referrers fill:#FFFDF5,stroke:#FDE68A,stroke-width:1px,color:#334155
