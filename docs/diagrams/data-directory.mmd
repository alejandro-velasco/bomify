flowchart TD
    classDef dir fill:#F8FAFF,stroke:#94A3B8,stroke-width:1.5px,color:#334155
    classDef store fill:#EEF2FF,stroke:#6366F1,stroke-width:1.5px,color:#1e1b4b
    classDef transient fill:#FFFBEB,stroke:#F59E0B,stroke-width:1.5px,stroke-dasharray:4 2,color:#78350f

    Root["baseDir/ (~/.bomify, or --data-dir)"]

    Root -->|"tags"| Package["package/"]
    Package -->|"repo -&gt; tag -&gt; sbom hash"| Repos[("repositories.json")]

    Root -->|"distribute, trust & scan config"| Conf["conf/"]
    Conf -->|"remote-endpoint rules, most specific match wins"| DistConfig[("distribution.json")]
    Conf -->|"signature verification rules, most specific match wins"| TrustConfig[("trust.json")]
    Conf -->|"vulnerability scanning policy rules, most specific match wins"| ScanConfig[("scan.json")]

    Root -->|"build & pull bookkeeping"| Manifests["manifests/"]
    Manifests -->|"SBOM build manifest, keyed by content hash"| ManifestFile[("&lt;hash&gt;.json")]
    Manifests -->|"marks a pull in flight, keyed by the same hash"| PidFile("&lt;hash&gt;.pid")

    Root -->|"pulled components"| Layers["layers/"]
    Layers -->|"one component's artifact, keyed by purl hash"| LayerDir[("&lt;purl-hash&gt;/")]

    Root -->|"security scan results"| Vulns["vulnerabilities/"]
    Vulns -->|"one component's vulnerability report, keyed by purl hash"| ReportFile[("&lt;purl-hash&gt;.json")]

    Root -->|"VEX documents scan policy rules name"| VEX["vex/"]
    VEX -->|"immutable copy, keyed by content hash"| VEXFile[("&lt;sha256&gt;.vex")]
    VEX -->|"name -&gt; content hash"| VEXIndex[("index.json")]

    Root -->|"installed plugins"| Plugins["plugins/"]
    Plugins -->|"the only place bomify finds a plugin"| PluginBin[("bomify-plugin-&lt;kind&gt;")]
    Plugins -->|"how bomify plugin install installed each"| PluginIndex[("installed.json")]

    Root -->|"plugin logs"| Logs["logs/"]
    Logs -->|"transient: exists only during that pull/push"| LogFile("&lt;purl-hash&gt;.log")

    class Root,Package,Conf,Manifests,Layers,Vulns,VEX,Plugins,Logs dir
    class Repos,DistConfig,TrustConfig,ScanConfig,ManifestFile,LayerDir,ReportFile,VEXFile,VEXIndex,PluginBin,PluginIndex store
    class PidFile,LogFile transient
