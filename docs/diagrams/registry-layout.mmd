flowchart LR
    classDef ref fill:#F8FAFF,stroke:#94A3B8,stroke-width:1.5px,color:#334155
    classDef index fill:#D1FAE5,stroke:#059669,stroke-width:2px,color:#022c22
    classDef manifest fill:#ECFDF5,stroke:#10B981,stroke-width:1.5px,color:#064e3b
    classDef referrer fill:#FFFBEB,stroke:#F59E0B,stroke-width:1.5px,color:#78350f

    subgraph Repo["package repository"]
        Tag["registry.example.com/team/myapp:1.0"]
        Index{{"package index"}}
        SBOM("SBOM manifest<br/>config: the SBOM<br/>layers: files map, extra files")
        Components("each component's own manifest:<br/>an image, a chart, ModelPack, or bomify's format")
        Deployments("deployments manifest<br/>layers: the deployment file, its templates")
        Referrers("referrers: reports, signatures,<br/>VEX, provenance")
    end

    subgraph Alias["component repository"]
        AliasTag["registry.example.com/team/myapp/helm/podinfo:6.7.1"]
    end

    Tag --> Index
    Index -- "first" --> SBOM
    Index -- "then each, with its<br/>purl and reference" --> Components
    Index -- "last, if it has any" --> Deployments
    SBOM -. "files map: which blob<br/>holds each file" .-> Components
    Referrers -- "subject" --> Index
    AliasTag -- "the same manifest,<br/>its blobs mounted" --> Components

    class Tag,AliasTag ref
    class Index index
    class SBOM,Components,Deployments manifest
    class Referrers referrer
    style Repo fill:#FFFFFF,stroke:#CBD5E1,stroke-width:1px,color:#334155
    style Alias fill:#FFFFFF,stroke:#CBD5E1,stroke-width:1px,color:#334155
