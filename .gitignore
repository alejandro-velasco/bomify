/bin/
/dist/

# Inputs a fuzz test failed on, which go test writes here: each becomes a
# named, readable test instead, as no generated input is committed.
testdata/fuzz/
*.exe
*.test
.DS_Store

# docsite/docs/usage/reference/ and docsite/docs/development/diagrams/ are
# copies of docs/reference/ and docs/diagrams/*.svg, made by `make
# docs-site`/`docs-site-sync`; docsite/site/ is the built static site.
# None is committed — see the docs-site-sync Makefile target.
/docsite/docs/usage/reference/
/docsite/docs/development/diagrams/
/docsite/site/
